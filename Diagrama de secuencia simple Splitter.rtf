@startuml S3_resumen_simple\
title Quien guarda que en el Almacen\
skinparam shadowing false\
skinparam sequenceMessageAlign left\
hide footbox\
\
participant Splitter\
participant "Tareas\\nintermedias" as T\
participant Aggregator\
participant Almacen\
\
Splitter -> Almacen : guardarOriginal(pedido)\
Splitter -> T : fragmento SIN stock\
T -> T : ContextEnricher anade el stock\
T -> Aggregator : fragmento CON stock\
Aggregator -> Almacen : guardarFragmento(fragmento)\
\
note over Splitter, Almacen\
  El Splitter guarda lo que no viaja: el pedido original.\
  El Aggregator guarda lo que viaja y cambia: los fragmentos.\
end note\
