@startuml S2_aggregator_simple\
title Aggregator\
skinparam shadowing false\
skinparam sequenceMessageAlign left\
hide footbox\
\
participant App\
participant Aggregator\
participant "Slot entrada" as E\
participant Almacen\
participant "Slot salida" as S\
\
App -> Aggregator : ejecutar()\
Aggregator -> E : leerMensaje()\
E --> Aggregator : fragmento\
Aggregator -> Almacen : guardarFragmento(fragmento)\
Aggregator -> Almacen : estaCompleto(idCorr)\
Almacen --> Aggregator : si\
\
Aggregator -> Almacen : obtenerFragmentos(idCorr)\
Almacen --> Aggregator : los n fragmentos\
Aggregator -> Almacen : obtenerOriginal(idCorr)\
Almacen --> Aggregator : pedido original\
Aggregator -> Aggregator : ordenarPorSecuencia()\
Aggregator -> Aggregator : reconstruir()\
Aggregator -> S : escribirMensaje(pedido)\
Aggregator -> Almacen : eliminar(idCorr)\
\
note over Aggregator\
  Si estaCompleto() dice que no, el Aggregator\
  no escribe nada y espera al siguiente fragmento.\
end note\
@enduml\
