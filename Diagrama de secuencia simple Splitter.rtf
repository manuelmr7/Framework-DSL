\f0\fs24 \cf0 @startuml S1_splitter_simple\
title Splitter\
skinparam shadowing false\
skinparam sequenceMessageAlign left\
hide footbox\
\
participant App\
participant Splitter\
participant "Slot entrada" as E\
participant Almacen\
participant "Slot salida" as S\
\
App -> Splitter : ejecutar()\
Splitter -> E : leerMensaje()\
E --> Splitter : pedido\
Splitter -> Almacen : guardarOriginal(pedido)\
\
